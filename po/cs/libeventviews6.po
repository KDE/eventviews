#: eventview.cpp:121
#, kde-format
msgctxt "@title:window"
msgid "Changing Recurring Item"
msgstr "Změna opakující se události"

#: eventview.cpp:122
#, kde-format
msgid "Also &Future Items"
msgstr "Také &budoucí položky"

#: eventview.cpp:123
#, kde-format
msgid "Only &This Item"
msgstr "Pouze &tato položka"

#: eventview.cpp:124
#, kde-format
msgid "&All Occurrences"
msgstr "Vš&echny výskyty"

#: eventview.cpp:141
#, kde-format
msgid ""
"The item you are trying to change is a recurring item. Should the changes be "
"applied only to this single occurrence, also to future items, or to all "
"items in the recurrence?"
msgstr ""
"Položka, kterou se pokoušíte změnit, je opakující se položka. Mají se změny "
"uplatnit pouze na tento jediný výskyt a na budoucí položky, nebo na všechny "
"opakované položky?"

#: eventview.cpp:152
#, kde-format
msgid ""
"The item you are trying to change is a recurring item. Should the changes be "
"applied only to this single occurrence or to all items in the recurrence?"
msgstr ""
"Položka, kterou se snažíte změnit, je opakující se položka. Mají se změny "
"použít pouze na tento konkrétní výskyt, nebo na všechny položky v rámci této "
"série?"

#. i18n: ectx: label, entry (DefaultEmailAttachMethod), group (Personal Settings)
#: eventviews.kcfg:9
#, kde-format
msgid "Default Email Attachment Method"
msgstr "Výchozí metoda příloh e-mailů"

#. i18n: ectx: whatsthis, entry (DefaultEmailAttachMethod), group (Personal Settings)
#: eventviews.kcfg:10
#, kde-format
msgid "The default way of attaching dropped emails to an event"
msgstr "Výchozí způsob přiřazování doručených e-mailů k události"

#. i18n: ectx: label, entry (DefaultEmailAttachMethod), group (Personal Settings)
#. i18n: ectx: label, entry (DefaultTodoAttachMethod), group (Hidden Options)
#: eventviews.kcfg:13 eventviews.kcfg:446
#, kde-format
msgid "Always ask"
msgstr "Vždy se dotázat"

#. i18n: ectx: label, entry (DefaultEmailAttachMethod), group (Personal Settings)
#. i18n: ectx: label, entry (DefaultTodoAttachMethod), group (Hidden Options)
#: eventviews.kcfg:16 eventviews.kcfg:449
#, kde-format
msgid "Only attach link to message"
msgstr "Pouze připojit odkaz na zprávu"

#. i18n: ectx: label, entry (DefaultEmailAttachMethod), group (Personal Settings)
#. i18n: ectx: label, entry (DefaultTodoAttachMethod), group (Hidden Options)
#: eventviews.kcfg:19 eventviews.kcfg:452
#, kde-format
msgid "Attach complete message"
msgstr "Připojit celou zprávu"

#. i18n: ectx: label, entry (DefaultEmailAttachMethod), group (Personal Settings)
#: eventviews.kcfg:22
#, kde-format
msgid "Attach message without attachments"
msgstr "Připojit zprávu bez příloh"

#. i18n: ectx: label, entry, group (Save Settings)
#: eventviews.kcfg:31
#, kde-format
msgid "Export to HTML with every save"
msgstr "Exportovat do HTML při každém uložení"

#. i18n: ectx: whatsthis, entry, group (Save Settings)
#: eventviews.kcfg:32
#, kde-format
msgid ""
"Check this box to export the calendar to a HTML-file every time you save it. "
"By default, this file will be called calendar.html and placed in the user "
"home folder."
msgstr ""
"Zaškrtněte pro export kalendáře do HTML souboru při každém uložení. Jako "
"výchozí bude soubor pojmenován calendar.html a bude umístěn v domácí složce."

#. i18n: ectx: label, entry, group (Save Settings)
#: eventviews.kcfg:36
#, kde-format
msgid "Enable automatic saving of manually opened calendar files"
msgstr "Povolit automatické ukládání ručně otevřených kalendářů"

#. i18n: ectx: whatsthis, entry, group (Save Settings)
#: eventviews.kcfg:37
#, kde-format
msgid ""
"Check this box to save your calendar file automatically when you exit "
"KOrganizer without asking and periodically, as you work. This setting does "
"not affect the automatic saving of the standard calendar, which is "
"automatically saved after each change."
msgstr ""
"Zaškrtněte pro automatické ukládání bez ptaní při ukončení programu "
"KOrganizer a periodicky, během vaší práce. Toto nastavení nemá vliv na "
"automatické ukládání vašeho standardního kalendáře, který se automaticky "
"ukládá po každé změně."

#. i18n: ectx: label, entry, group (Save Settings)
#: eventviews.kcfg:41
#, kde-format
msgid "Save &interval in minutes"
msgstr "&Interval ukládání v minutách"

#. i18n: ectx: whatsthis, entry, group (Save Settings)
#: eventviews.kcfg:42
#, kde-format
msgid ""
"Set the interval between automatic saving of calendar events in minutes "
"here. This setting only applies to files that are opened manually. The "
"standard KDE-wide calendar is automatically saved after each change."
msgstr ""
"Zde zadejte interval pro automatické uložení kalendáře v minutách. Toto "
"nastavení je platné pouze pro soubory, které jsou otevřeny ručně. Standardní "
"globální kalendář KDE se ukládá automaticky po každé změně."

#. i18n: ectx: label, entry (Confirm), group (Save Settings)
#: eventviews.kcfg:47
#, kde-format
msgid "Confirm deletes"
msgstr "Potvrdit smazání"

#. i18n: ectx: whatsthis, entry (Confirm), group (Save Settings)
#: eventviews.kcfg:48
#, kde-format
msgid "Check this box to display a confirmation dialog when deleting items."
msgstr ""
"Zaškrtněte, pokud si přejete nechat zobrazovat žádost o potvrzení smazání "
"položek."

#. i18n: ectx: label, entry (Destination), group (Save Settings)
#: eventviews.kcfg:52
#, kde-format
msgid "New Events, To-dos and Journal Entries Should"
msgstr "Nové události, úkoly a položky deníku mají"

#. i18n: ectx: label, entry (Destination), group (Save Settings)
#: eventviews.kcfg:55
#, kde-format
msgid "Be added to the standard calendar"
msgstr "Přidat do standardního kalendáře"

#. i18n: ectx: whatsthis, entry (Destination), group (Save Settings)
#: eventviews.kcfg:56
#, kde-format
msgid ""
"Select this option to always record new events, to-dos and journal entries "
"using the standard calendar."
msgstr ""
"Tuto možnost vyberte, chcete-li nové události, úkoly a záznamy do deníku "
"vždy zaznamenávat pomocí standardního kalendáře."

#. i18n: ectx: label, entry (Destination), group (Save Settings)
#: eventviews.kcfg:59
#, kde-format
msgid "Be asked which calendar to use"
msgstr "Zeptat se, který kalendář použít"

#. i18n: ectx: whatsthis, entry (Destination), group (Save Settings)
#: eventviews.kcfg:60
#, kde-format
msgid ""
"Select this option to choose the calendar to be used to record the item each "
"time you create a new event, to-do or journal entry. This choice is "
"recommended if you intend to use the shared folders functionality of the "
"Kolab server or have to manage multiple accounts using Kontact as a KDE "
"Kolab client. "
msgstr ""
"Tuto možnost vyberte, pokud chcete zvolit kalendář, který se použije k "
"zaznamenání položky pokaždé, když vytvoříte novou událost, úkol nebo záznam "
"do deníku. Tato volba se doporučuje, pokud hodláte používat funkci sdílených "
"složek serveru Kolab nebo pokud musíte spravovat více účtů pomocí aplikace "
"Kontact jako klienta KDE Kolab. "

#. i18n: ectx: label, entry, group (System Tray)
#: eventviews.kcfg:69
#, kde-format
msgid "Show Reminder Daemon in the System Tray"
msgstr "Zobrazovat ikonu připomínek v systémové části panelu"

#. i18n: ectx: whatsthis, entry, group (System Tray)
#: eventviews.kcfg:70
#, kde-format
msgid ""
"Check this box to show the KOrganizer reminder daemon in the system tray."
msgstr ""
"Zaškrtněte toto políčko, chcete-li zobrazit démon připomínek KOrganizeru v "
"systémové liště."

#. i18n: ectx: whatsthis, entry (TimeZoneId), group (Time &amp; Date)
#: eventviews.kcfg:77
#, kde-format
msgid ""
"Select your timezone from the list of locations in this drop down box. If "
"your city is not listed, select one which shares the same timezone. "
"KOrganizer will automatically adjust for daylight savings."
msgstr ""
"Vyberte si z roletového seznamu míst vaše časové pásmo. Není-li vaše město v "
"seznamu, vyberte si jiné, které leží ve stejném časovém pásmu. KOrganizer "
"bude automaticky upravovat přechod na letní čas."

#. i18n: ectx: label, entry (DayBegins), group (Time &amp; Date)
#: eventviews.kcfg:80
#, kde-format
msgid "Day begins at"
msgstr "Den začíná v"

#. i18n: ectx: whatsthis, entry (DayBegins), group (Time &amp; Date)
#: eventviews.kcfg:81
#, kde-format
msgid ""
"Enter the start time for events here. This time should be the earliest time "
"that you use for events, as it will be displayed at the top."
msgstr ""
"Zde zadejte počáteční čas pro události každého dne. Toto by měl být čas, "
"který pro události používáte nejdříve, neboť bude zobrazen úplně nahoře."

#. i18n: ectx: label, entry (WorkingHoursStart), group (Time &amp; Date)
#: eventviews.kcfg:85
#, kde-format
msgid "Daily starting hour"
msgstr "Začátek dne"

#. i18n: ectx: whatsthis, entry (WorkingHoursStart), group (Time &amp; Date)
#: eventviews.kcfg:86
#, kde-format
msgid ""
"Enter the start time for the working hours here. The working hours will be "
"marked with color by KOrganizer."
msgstr ""
"Zde zadejte počáteční čas vašeho pracovního dne. Pracovní hodiny budou "
"programem KOrganizer barevně označeny."

#. i18n: ectx: label, entry (WorkingHoursEnd), group (Time &amp; Date)
#: eventviews.kcfg:90
#, kde-format
msgid "Daily ending hour"
msgstr "Konec dne"

#. i18n: ectx: whatsthis, entry (WorkingHoursEnd), group (Time &amp; Date)
#: eventviews.kcfg:91
#, kde-format
msgid ""
"Enter the ending time for the working hours here. The working hours will be "
"marked with color by KOrganizer."
msgstr ""
"Zde zadejte koncový čas vašeho pracovního dne. Pracovní hodiny budou "
"programem KOrganizer barevně označeny."

#. i18n: ectx: label, entry (WeekStartDay), group (Time &amp; Date)
#: eventviews.kcfg:95
#, kde-format
msgid "Weekly start day:"
msgstr "Počáteční den týdne:"

#. i18n: ectx: tooltip, entry (WeekStartDay), group (Time &amp; Date)
#: eventviews.kcfg:96
#, kde-format
msgid "Select the first day of each week"
msgstr "První den v týdnu"

#. i18n: ectx: whatsthis, entry (WeekStartDay), group (Time &amp; Date)
#: eventviews.kcfg:97
#, kde-format
msgid ""
"Select the first day of each week. Normally, you can ignore this since it is "
"set in your locale."
msgstr ""
"Vyberte první den každého týdne. Normálně to můžete ignorovat, protože je to "
"nastaveno ve vašem místním nastavení."

#. i18n: ectx: label, entry, group (General View)
#: eventviews.kcfg:104 viewerapp/settings.kcfg:9
#, kde-format
msgid "Enable tooltips for displaying summaries"
msgstr "Povolit zobrazování tipů se souhrnem událostí"

#. i18n: ectx: whatsthis, entry, group (General View)
#: eventviews.kcfg:105 viewerapp/settings.kcfg:10
#, kde-format
msgid ""
"Check this box to display summary tooltips when hovering the mouse over an "
"event or a to-do."
msgstr ""
"Zaškrtněte pro zobrazení přehledu události jako tip při najetí myší na danou "
"událost nebo úkol."

#. i18n: ectx: label, entry, group (General View)
#: eventviews.kcfg:109
#, kde-format
msgid "To-dos use tag colors"
msgstr "Úkoly používají barvy značek"

#. i18n: ectx: whatsthis, entry, group (General View)
#: eventviews.kcfg:110
#, kde-format
msgid ""
"Check this box so that to-dos will use tag colors and not colors specific to "
"their due, due today or overdue state"
msgstr ""
"Zaškrtněte toto políčko, aby úkoly používaly barvy značek a ne barvy "
"specifické pro jejich stav splnění, splnění dnes nebo po splnění"

#. i18n: ectx: label, entry, group (General View)
#: eventviews.kcfg:114
#, kde-format
msgid "Next x days"
msgstr "Následujících X dní"

#. i18n: ectx: whatsthis, entry, group (General View)
#: eventviews.kcfg:115
#, kde-format
msgid ""
"Select the number of \"x\" days to be displayed in the next days view. To "
"access the next \"x\" days view, choose the \"Next X Days\" menu item from "
"the \"View\" menu."
msgstr ""
"Vyberte počet \"x\" dnů, které se mají zobrazit v zobrazení následujících "
"dnů. Chcete-li přejít na zobrazení následujících \"x\" dnů, vyberte položku "
"nabídky \"Dalších X dnů\" z nabídky \"Zobrazení\"."

#. i18n: ectx: tooltip, entry, group (General View)
#: eventviews.kcfg:116
#, kde-format
msgid "Show this many days at a time in the Next \"x\" days view"
msgstr "Zobrazit tento počet dnů najednou v zobrazení \"x\" následujících dní"

#. i18n: ectx: label, entry (DailyRecur), group (General View)
#: eventviews.kcfg:120
#, kde-format
msgid "Show items that recur daily"
msgstr "Zobrazit položky, které se opakují denně"

#. i18n: ectx: whatsthis, entry (DailyRecur), group (General View)
#: eventviews.kcfg:121
#, kde-format
msgid ""
"Check this box to show the days containing daily recurring events in bold "
"typeface in the Date Navigator, or uncheck it to give more prominence to "
"other (non daily recurring) events."
msgstr ""
"Zaškrtněte, pokud si přejete v Navigátoru zobrazit dny, které obsahují denně "
"se opakující události, tučným písmem. Zrušte zaškrtnutí, pokud si přejete "
"dát větší význam ostatním událostem (neopakujícím se každý den)."

#. i18n: ectx: label, entry (WeeklyRecur), group (General View)
#: eventviews.kcfg:125
#, kde-format
msgid "Show items that recur weekly"
msgstr "Zobrazit položky, které se opakují týdně"

#. i18n: ectx: whatsthis, entry (WeeklyRecur), group (General View)
#: eventviews.kcfg:126
#, kde-format
msgid ""
"Check this box to show the days containing weekly recurring events in bold "
"typeface in the Date Navigator, or uncheck it to give more prominence to "
"other (non weekly recurring) events."
msgstr ""
"Zaškrtněte, pokud si přejete v Navigátoru zobrazit dny, které obsahují týdně "
"se opakující události, tučným písmem. Zrušte zaškrtnutí, pokud si přejete "
"dát větší význam ostatním událostem (neopakujícím se každý týden)."

#. i18n: ectx: label, entry (HighlightTodos), group (General View)
#: eventviews.kcfg:130
#, kde-format
msgid "Show to-dos instead of events when in Todo View"
msgstr "Zobrazit úkoly namísto událostí v zobrazení úkolů"

#. i18n: ectx: whatsthis, entry (HighlightTodos), group (General View)
#: eventviews.kcfg:131
#, kde-format
msgid ""
"Check this box to show the days containing to-dos in bold typeface in the "
"Date Navigator when in to-do view."
msgstr ""
"Zaškrtněte toto políčko, chcete-li v Navigátoru při zobrazení úkolů "
"zvýraznit dny obsahující úkoly tučným písmem."

#. i18n: ectx: label, entry (HighlightJournals), group (General View)
#: eventviews.kcfg:135
#, kde-format
msgid "Show journals instead of events when in Journal View"
msgstr "Zobrazit deníky namísto událostí v zobrazení deníku"

#. i18n: ectx: whatsthis, entry (HighlightJournals), group (General View)
#: eventviews.kcfg:136
#, kde-format
msgid ""
"Check this box to show the days containing journals in bold typeface in the "
"Date Navigator when in journal view."
msgstr ""
"Zaškrtněte toto políčko, chcete-li v Navigátoru při zobrazení deníků "
"zvýraznit dny obsahující deníky tučným písmem."

#. i18n: ectx: label, entry (WeekNumbersShowWork), group (General View)
#: eventviews.kcfg:140
#, kde-format
msgid "Week numbers select a work week when in work week mode"
msgstr "Čísla týdnů vybírají pracovní týden v režimu pracovního týdne"

#. i18n: ectx: whatsthis, entry (WeekNumbersShowWork), group (General View)
#: eventviews.kcfg:141
#, kde-format
msgid ""
"Check this box to select a working week when clicking on the Date "
"Navigator's week numbers, or uncheck it to choose the whole week."
msgstr ""
"Zaškrtněte toto políčko, chcete-li při kliknutí na čísla týdnů v Navigátoru "
"vybrat pracovní týden, nebo zaškrtnutí zrušte, chcete-li vybrat celý týden."

#. i18n: ectx: label, entry, group (Agenda View)
#: eventviews.kcfg:148 viewerapp/settings.kcfg:17
#, kde-format
msgid "Hour size"
msgstr "Velikost hodiny"

#. i18n: ectx: whatsthis, entry, group (Agenda View)
#: eventviews.kcfg:149 viewerapp/settings.kcfg:18
#, kde-format
msgid ""
"Select the height of the hour rows in the agenda grid, in pixels. Increasing "
"this value will make each row in the agenda grid taller."
msgstr ""
"Vyberte výšku řádků hodin v mřížce agendy v pixelech. Zvýšením této hodnoty "
"se každý řádek v mřížce agendy zvětší."

#. i18n: ectx: tooltip, entry, group (Agenda View)
#: eventviews.kcfg:150 viewerapp/settings.kcfg:19
#, kde-format
msgid "Set the height (in pixels) for an hour in the agenda grid"
msgstr "Nastavit výšku (v pixelech) pro hodiny v mřížce agendy"

#. i18n: ectx: label, entry (EnableAgendaBoldEvenHours), group (Agenda View)
#: eventviews.kcfg:156
#, kde-format
msgid "Draw bold horizontal grid lines for the even hours"
msgstr "Nakreslit výrazné vodorovné čáry mřížky pro sudé hodiny"

#. i18n: ectx: whatsthis, entry (EnableAgendaBoldEvenHours), group (Agenda View)
#: eventviews.kcfg:157
#, kde-format
msgid ""
"Draw a bolder horizontal grid line for the even hours (12am, 2am, 4am, etc)."
msgstr ""
"Nakreslit silnější vodorovnou čáru mřížky pro sudé hodiny (0:00, 2:00, 4:00 "
"atd.)."

#. i18n: ectx: tooltip, entry (EnableAgendaBoldEvenHours), group (Agenda View)
#: eventviews.kcfg:158
#, kde-format
msgid "Draw bolder even hour grid lines"
msgstr "Nakreslit výraznější čáry hodinové mřížky"

#. i18n: ectx: label, entry (EnableAgendaItemIcons), group (Agenda View)
#: eventviews.kcfg:162 viewerapp/settings.kcfg:25
#, kde-format
msgid "Show icons in agenda view items"
msgstr "Zobrazit ikony v položkách zobrazení agendy"

#. i18n: ectx: whatsthis, entry (EnableAgendaItemIcons), group (Agenda View)
#: eventviews.kcfg:163 viewerapp/settings.kcfg:26
#, kde-format
msgid ""
"Check this box to display icons (alarm, recursion, etc.) in agenda view "
"items."
msgstr ""
"Zaškrtněte toto políčko, chcete-li zobrazit ikony (alarm, rekurze atd.) v "
"položkách zobrazení agendy."

#. i18n: ectx: tooltip, entry (EnableAgendaItemIcons), group (Agenda View)
#: eventviews.kcfg:164 viewerapp/settings.kcfg:27
#, kde-format
msgid "Display icons in agenda view items"
msgstr "Zobrazit ikony v položkách zobrazení agendy"

#. i18n: ectx: label, entry (EnableAgendaItemDesc), group (Agenda View)
#: eventviews.kcfg:168
#, kde-format
msgid "Show incidence descriptions in agenda view items"
msgstr "Zobrazit popisy položek v zobrazení agendy"

#. i18n: ectx: whatsthis, entry (EnableAgendaItemDesc), group (Agenda View)
#: eventviews.kcfg:169
#, kde-format
msgid ""
"Check this box to display the incidence descriptions in agenda view items."
msgstr ""
"Zaškrtněte toto políčko, chcete-li zobrazit popisy položek v zobrazení "
"agendy."

#. i18n: ectx: tooltip, entry (EnableAgendaItemDesc), group (Agenda View)
#: eventviews.kcfg:170
#, kde-format
msgid "Display incidence descriptions in agenda view items"
msgstr "Zobrazit popisy událostí v položkách zobrazení agendy"

#. i18n: ectx: label, entry (EnableAgendaItemLocation), group (Agenda View)
#: eventviews.kcfg:174
#, kde-format
msgid "Show incidence locations in agenda view items"
msgstr "Zobrazit umístění položek v zobrazení agendy"

#. i18n: ectx: whatsthis, entry (EnableAgendaItemLocation), group (Agenda View)
#: eventviews.kcfg:175
#, kde-format
msgid "Check this box to display the incidence locations in agenda view items."
msgstr ""
"Zaškrtněte toto políčko, chcete-li v zobrazení agendy zobrazit umístění "
"položek."

#. i18n: ectx: tooltip, entry (EnableAgendaItemLocation), group (Agenda View)
#: eventviews.kcfg:176
#, kde-format
msgid "Display incidence locations in agenda view items"
msgstr "Zobrazit místa událostí v položkách zobrazení agendy"

#. i18n: ectx: label, entry (ColorBusyDaysEnabled), group (Agenda View)
#. i18n: ectx: label, entry (ColorMonthBusyDaysEnabled), group (Month View)
#: eventviews.kcfg:180 eventviews.kcfg:282
#, kde-format
msgid "Color busy days with a different background color"
msgstr "Označit zaneprázdněné dny jinou barvou pozadí"

#. i18n: ectx: whatsthis, entry (ColorBusyDaysEnabled), group (Agenda View)
#: eventviews.kcfg:181
#, kde-format
msgid ""
"Check this box if you want agenda's background to be filled with a different "
"color on days which have at least one all day event marked as busy. Also, "
"you can change the background color used for this option on the Colors "
"configuration page. Look for the \"Busy days background color\" setting."
msgstr ""
"Zaškrtněte toto políčko, pokud chcete, aby pozadí kalendáře bylo vyplněno "
"jinou barvou u dnů, které mají alespoň jednu celodenní událost označenou "
"jako zaneprázdněnou. Barvu pozadí použitou pro tuto možnost můžete také "
"změnit na stránce konfigurace barev . Vyhledejte nastavení \"Barva pozadí "
"zaneprázdněných dnů\"."

#. i18n: ectx: label, entry (ShowTodosAgendaView), group (Agenda View)
#. i18n: ectx: label, entry (ShowTodosMonthView), group (Month View)
#: eventviews.kcfg:185 eventviews.kcfg:288 viewerapp/settings.kcfg:31
#: viewerapp/settings.kcfg:116
#, kde-format
msgid "Show to-dos"
msgstr "Zobrazit úkoly"

#. i18n: ectx: whatsthis, entry (ShowTodosAgendaView), group (Agenda View)
#: eventviews.kcfg:186 viewerapp/settings.kcfg:32
#, kde-format
msgid "Check this box to display to-dos in the agenda view."
msgstr "Zaškrtněte toto políčko, chcete-li zobrazit úkoly v zobrazení agendy."

#. i18n: ectx: tooltip, entry (ShowTodosAgendaView), group (Agenda View)
#: eventviews.kcfg:187 viewerapp/settings.kcfg:33
#, kde-format
msgid "Display to-dos in the agenda view"
msgstr "Zobrazit úkoly v zobrazení agendy"

#. i18n: ectx: label, entry (MarcusBainsEnabled), group (Agenda View)
#: eventviews.kcfg:191 viewerapp/settings.kcfg:37
#, kde-format
msgid "Show current-time (Marcus Bains) line"
msgstr "Zobrazit aktuální čas (čára Marcuse Bainse)"

#. i18n: ectx: whatsthis, entry (MarcusBainsEnabled), group (Agenda View)
#: eventviews.kcfg:192 viewerapp/settings.kcfg:38
#, kde-format
msgid ""
"Check this box to display a line in the day or week view indicating the "
"current-time line (Marcus Bains line)."
msgstr ""
"Zaškrtněte toto políčko, chcete-li v denním nebo týdenním zobrazení zobrazit "
"čáru označující aktuální čas (Marcus Bainsova čára)."

#. i18n: ectx: tooltip, entry (MarcusBainsEnabled), group (Agenda View)
#: eventviews.kcfg:193 viewerapp/settings.kcfg:39
#, kde-format
msgid "Display the current-time indicator"
msgstr "Zobrazit ukazatel aktuálního času"

#. i18n: ectx: label, entry (MarcusBainsShowSeconds), group (Agenda View)
#: eventviews.kcfg:197 viewerapp/settings.kcfg:43
#, kde-format
msgid "Show seconds on the current-time (Marcus Bains) line"
msgstr "Zobrazit sekundy na čáře aktuálního času (Marcus Bains)"

#. i18n: ectx: whatsthis, entry (MarcusBainsShowSeconds), group (Agenda View)
#: eventviews.kcfg:198 viewerapp/settings.kcfg:44
#, kde-format
msgid "Check this box if you want to show seconds on the current-time line."
msgstr "Zaškrtněte, pokud si přejete zobrazit sekundy na čáře aktuálního času."

#. i18n: ectx: tooltip, entry (MarcusBainsShowSeconds), group (Agenda View)
#: eventviews.kcfg:199 viewerapp/settings.kcfg:45
#, kde-format
msgid "Display seconds with the current-time indicator"
msgstr "Zobrazit sekundy na čáře aktuálního času"

#. i18n: ectx: label, entry (SelectionStartsEditor), group (Agenda View)
#: eventviews.kcfg:203 viewerapp/settings.kcfg:49
#, kde-format
msgid "Time range selection in agenda view starts event editor"
msgstr "Označení časového intervalu v agendě spustí editor událostí"

#. i18n: ectx: whatsthis, entry (SelectionStartsEditor), group (Agenda View)
#: eventviews.kcfg:204 viewerapp/settings.kcfg:50
#, kde-format
msgid ""
"Check this box to start the event editor automatically when you select a "
"time range in the daily and weekly view. To select a time range, drag the "
"mouse from the start time to the end time of the event you are about to plan."
msgstr ""
"Zaškrtněte pro automatické otevření editoru události po označení časového "
"intervalu v denním, resp. týdenním pohledu. Pro výběr časového intervalu "
"označte myší požadovaný úsek, tj. počáteční a koncový čas události, kterou "
"hodláte plánovat."

#. i18n: ectx: tooltip, entry (SelectionStartsEditor), group (Agenda View)
#: eventviews.kcfg:205 viewerapp/settings.kcfg:51
#, kde-format
msgid "Enable automatic event editor with time range selection"
msgstr "Povolit automatický editor událostí s výběrem časového rozsahu"

#. i18n: ectx: label, entry, group (Agenda View)
#: eventviews.kcfg:209
#, kde-format
msgid "Agenda Item Color"
msgstr "Barva položky agendy"

#. i18n: ectx: label, entry, group (Agenda View)
#. i18n: ectx: label, entry, group (Month View)
#: eventviews.kcfg:212 eventviews.kcfg:321
#, kde-format
msgid "Tag inside, calendar outside"
msgstr "Značka uvnitř, kalendář vně"

#. i18n: ectx: tooltip, entry, group (Agenda View)
#: eventviews.kcfg:213
#, kde-format
msgid ""
"Draw agenda items in their tag color inside and calendar color for their "
"border"
msgstr ""
"Zobrazit body agendy v barvě jejich značky uvnitř a v barvě kalendáře na "
"okraji"

#. i18n: ectx: whatsthis, entry, group (Agenda View)
#: eventviews.kcfg:214
#, kde-format
msgid ""
"Select the \"Tag inside, calendar outside\" option if you would like to draw "
"calendar items in their associated tag color, with the item's border drawn "
"in the color of its calendar. Please use the Colors and Fonts configuration "
"page for setting these colors."
msgstr ""
"Vyberte možnost \"Značka uvnitř, kalendář vně\", pokud chcete, aby se "
"položky kalendáře zobrazovaly v barvě příslušného štítku a jejich ohraničení "
"bylo v barvě příslušného kalendáře. K nastavení těchto barev použijte "
"stránku nastavení \"Barvy a písma\"."

#. i18n: ectx: label, entry, group (Agenda View)
#. i18n: ectx: label, entry, group (Month View)
#: eventviews.kcfg:217 eventviews.kcfg:326
#, kde-format
msgid "Calendar inside, tag outside"
msgstr "Kalendář uvnitř, značka vně"

#. i18n: ectx: tooltip, entry, group (Agenda View)
#: eventviews.kcfg:218
#, kde-format
msgid ""
"Draw agenda items in their calendar color inside and tag color for their "
"border"
msgstr ""
"Vytvořit položky agendy v barvě kalendáře uvnitř a v barvě značky pro jejich "
"okraje"

#. i18n: ectx: whatsthis, entry, group (Agenda View)
#: eventviews.kcfg:219
#, kde-format
msgid ""
"Select the \"Calendar inside, tag outside\" option if you would like to draw "
"calendar items in their associated calendar color, with the item's border "
"drawn in the color of its tag. Please use the Colors and Fonts configuration "
"page for setting these colors."
msgstr ""
"Vyberte možnost „Kalendář uvnitř, značka vně“, pokud chcete, aby se položky "
"kalendáře zobrazovaly v barvě příslušného kalendáře a jejich ohraničení bylo "
"v barvě příslušné značky. K nastavení těchto barev použijte stránku "
"nastavení Barvy a písma."

#. i18n: ectx: label, entry, group (Agenda View)
#. i18n: ectx: label, entry, group (Month View)
#: eventviews.kcfg:222 eventviews.kcfg:331
#, kde-format
msgid "Only tag"
msgstr "Pouze značka"

#. i18n: ectx: tooltip, entry, group (Agenda View)
#: eventviews.kcfg:223
#, kde-format
msgid "Draw agenda items using their tag color for the inside and border"
msgstr ""
"Vytvořit položky agendy pomocí barvy jejich značky pro vnitřní část a okraj"

#. i18n: ectx: whatsthis, entry, group (Agenda View)
#: eventviews.kcfg:224
#, kde-format
msgid ""
"Select the \"Only tag\" option if you would like to draw calendar items "
"(both inside and border) in the color of their associated tag. Please use "
"the Colors and Fonts configuration page for setting these colors."
msgstr ""
"Vyberte možnost \"Pouze značka\", pokud chcete vytvořit položky kalendáře "
"(uvnitř i na okraji) v barvě jejich přidružené značky. K nastavení těchto "
"barev použijte stránku nastavení Barvy a písma."

#. i18n: ectx: label, entry, group (Agenda View)
#. i18n: ectx: label, entry, group (Month View)
#: eventviews.kcfg:227 eventviews.kcfg:336 viewerapp/settings.kcfg:73
#: viewerapp/settings.kcfg:151
#, kde-format
msgid "Only calendar"
msgstr "Pouze kalendář"

#. i18n: ectx: tooltip, entry, group (Agenda View)
#: eventviews.kcfg:228 viewerapp/settings.kcfg:75
#, kde-format
msgid "Draw agenda items using their calendar color for the inside and border"
msgstr ""
"Vytvořit položky agendy pomocí barev kalendáře pro vnitřní část a okraj"

#. i18n: ectx: whatsthis, entry, group (Agenda View)
#: eventviews.kcfg:229 viewerapp/settings.kcfg:74
#, kde-format
msgid ""
"Select the \"Only calendar\" option if you would like to draw calendar items "
"(both inside and border) in the color of their calendar. Please use the "
"Colors and Fonts configuration page for setting these colors."
msgstr ""
"Vyberte možnost \"Pouze kalendář\", pokud chcete vytvořit položky kalendáře "
"(uvnitř i na okraji) v barvě jejich kalendáře. K nastavení těchto barev "
"použijte stránku nastavení Barvy a písma."

#. i18n: ectx: label, entry (AgendaViewCalendarDisplay), group (Agenda View)
#: eventviews.kcfg:235 viewerapp/settings.kcfg:81
#, kde-format
msgid "Multiple Calendar Display"
msgstr "Zobrazení více kalendářů"

#. i18n: ectx: label, entry (AgendaViewCalendarDisplay), group (Agenda View)
#: eventviews.kcfg:238 viewerapp/settings.kcfg:84
#, kde-format
msgid "Merge all calendars into one view"
msgstr "Sloučit všechny kalendáře do jednoho pohledu"

#. i18n: ectx: whatsthis, entry (AgendaViewCalendarDisplay), group (Agenda View)
#: eventviews.kcfg:239 viewerapp/settings.kcfg:85
#, kde-format
msgid ""
"Select the \"Merge all calendars into one view\" option if you would like "
"all your calendars to be shown together in one agenda view."
msgstr ""
"Vyberte možnost \"Sloučit všechny kalendáře do jednoho zobrazení\", pokud "
"chcete, aby se všechny vaše kalendáře zobrazovaly společně v jednom "
"zobrazení agendy."

#. i18n: ectx: tooltip, entry (AgendaViewCalendarDisplay), group (Agenda View)
#: eventviews.kcfg:240 viewerapp/settings.kcfg:86
#, kde-format
msgid "Show all calendars merged together"
msgstr "Zobrazit všechny kalendáře sloučené dohromady"

#. i18n: ectx: label, entry (AgendaViewCalendarDisplay), group (Agenda View)
#: eventviews.kcfg:243 viewerapp/settings.kcfg:89
#, kde-format
msgid "Show calendars side by side"
msgstr "Zobrazit kalendáře vedle sebe"

#. i18n: ectx: whatsthis, entry (AgendaViewCalendarDisplay), group (Agenda View)
#: eventviews.kcfg:244 viewerapp/settings.kcfg:90
#, kde-format
msgid ""
"Select the \"Show calendars side by side\" option if you would like to see "
"two calendars at once, in a side-by-side view."
msgstr ""
"Chcete-li zobrazit dva kalendáře najednou vedle sebe, vyberte možnost "
"\"Zobrazit dva kalendáře vedle sebe\"."

#. i18n: ectx: tooltip, entry (AgendaViewCalendarDisplay), group (Agenda View)
#: eventviews.kcfg:245 viewerapp/settings.kcfg:91
#, kde-format
msgid "Show two calendars side-by-side"
msgstr "Zobrazit dva kalendáře vedle sebe"

#. i18n: ectx: label, entry (AgendaViewCalendarDisplay), group (Agenda View)
#: eventviews.kcfg:248 viewerapp/settings.kcfg:94
#, kde-format
msgid "Switch between views with tabs"
msgstr "Přepnout se mezi pohledu pomocí karet"

#. i18n: ectx: whatsthis, entry (AgendaViewCalendarDisplay), group (Agenda View)
#: eventviews.kcfg:249 viewerapp/settings.kcfg:95
#, kde-format
msgid ""
"Select \"Switch between views with tabs\" if you would like to alternate "
"between calendars using the tab key."
msgstr ""
"Vyberte možnost \"Přepnout se mezi zobrazeními pomocí Tab\", pokud chcete "
"přepínat mezi kalendáři pomocí klávesy Tab."

#. i18n: ectx: tooltip, entry (AgendaViewCalendarDisplay), group (Agenda View)
#: eventviews.kcfg:250 viewerapp/settings.kcfg:96
#, kde-format
msgid "Tab through calendars"
msgstr "Přejít mezi kalendáři pomocí Tab"

#. i18n: ectx: label, entry (EnableMonthScroll), group (Month View)
#: eventviews.kcfg:259 viewerapp/settings.kcfg:105
#, kde-format
msgid "Enable scrollbars in month view cells"
msgstr "Povolit rolovací panely v buňkách náhledu měsíce"

#. i18n: ectx: whatsthis, entry (EnableMonthScroll), group (Month View)
#: eventviews.kcfg:260 viewerapp/settings.kcfg:106
#, kde-format
msgid ""
"Check this box to display scrollbars when clicking on a cell in the month "
"view; they will only appear when needed though."
msgstr ""
"Zaškrtněte pro zobrazení rolovacího panelu při kliknutí na buňku v měsíčním "
"pohledu - bude zobrazeno pouze pokud to bude nutné."

#. i18n: ectx: label, entry (EnableMonthItemIcons), group (Month View)
#: eventviews.kcfg:264 viewerapp/settings.kcfg:110
#, kde-format
msgid "Show icons in month view items"
msgstr "Zobrazit ikony v položkách měsíčního zobrazení"

#. i18n: ectx: whatsthis, entry (EnableMonthItemIcons), group (Month View)
#: eventviews.kcfg:265 viewerapp/settings.kcfg:111
#, kde-format
msgid ""
"Check this box to display icons (alarm, recursion, etc.) in month view items."
msgstr ""
"Zaškrtněte toto políčko, chcete-li zobrazit ikony (alarm, rekurze atd.) v "
"položkách měsíčního zobrazení."

#. i18n: ectx: tooltip, entry (EnableMonthItemIcons), group (Month View)
#: eventviews.kcfg:266 viewerapp/settings.kcfg:112
#, kde-format

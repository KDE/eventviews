#: agenda/timelabels.cpp:434
#, kde-format
msgctxt "heading for timezone country"
msgid "<i>Country:</i> %1"
msgstr "<i>Země:</i> %1"

#: agenda/timelabels.cpp:446
#, kde-format
msgctxt "heading for comma-separated list of timezone abbreviations"
msgid "<i>Abbreviations:</i>"
msgstr "<i>Zkratky:</i>"

#: agenda/timelabels.cpp:452
#, kde-format
msgctxt "heading for the timezone comment"
msgid "<i>Comment:</i> %1"

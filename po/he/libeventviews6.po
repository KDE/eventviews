#~ msgid "Default Email Attachment Method"
#~ msgstr "שיטת צירוף הודעות דוא״ל כברירת מחדל"

#~ msgid "The default way of attaching dropped emails to an event"
#~ msgstr "דרך ברירת המחדל לצירוף הודעות שנגררו לתוך אירוע"

#~ msgid "Attach message without attachments"
#~ msgstr "צירוף ההודעה ללא הקבצים שצורפו אליה"

#~ msgid "Export to HTML with every save"
#~ msgstr "ייצוא ל־HTML בכל שמירה"

#~ msgid ""
#~ "Check this box to export the calendar to a HTML-file every time you save "
#~ "it. By default, this file will be called calendar.html and placed in the "
#~ "user home folder."
#~ msgstr ""
#~ "יש לסמן את התיבה הזאת כדי לייצר את לוח השנה לקובץ HTML עם כל שמירה שלו. "
#~ "כברירת מחדל הקובץ הזה ייקרא calendar.html ויוצב בתיקיית הבית של המשתמש."

#~ msgid "Enable automatic saving of manually opened calendar files"
#~ msgstr "הפעלת שמירה אוטומטית של קובצי לוח שנה שנפתחו ידנית"

#~ msgid ""
#~ "Check this box to save your calendar file automatically when you exit "
#~ "KOrganizer without asking and periodically, as you work. This setting "
#~ "does not affect the automatic saving of the standard calendar, which is "
#~ "automatically saved after each change."
#~ msgstr ""
#~ "יש לסמן את התיבה הזאת כדי לשמור את קובץ לוח השנה שלך אוטומטית ביציאה מ־"
#~ "KOrganizer מבלי לשאול ובמחזוריות, תוך כדי עבודה. ההגדרות הזאת לא משפיעה "
#~ "על שמירת לוח השנה הרגיל אוטומטית, שמתבצעת אחרי כל שינוי."

#~ msgid "Save &interval in minutes"
#~ msgstr "ה&פרשי שמירות בדקות"

#~ msgid ""
#~ "Set the interval between automatic saving of calendar events in minutes "
#~ "here. This setting only applies to files that are opened manually. The "
#~ "standard KDE-wide calendar is automatically saved after each change."
#~ msgstr ""
#~ "כאן אפשר להגדיר את ההפרש בין שמירות אירועי לוח שנה אוטומטיות בדקות. "
#~ "ההגדרות הזאת חלה רק על קבצים שנפתחו ידנית. לוח השנה הכולל ל־KDE נשמר "
#~ "אוטומטית אחרי כל שינוי."

#~ msgid ""
#~ "Select this option to choose the calendar to be used to record the item "
#~ "each time you create a new event, to-do or journal entry. This choice is "
#~ "recommended if you intend to use the shared folders functionality of the "
#~ "Kolab server or have to manage multiple accounts using Kontact as a KDE "
#~ "Kolab client. "
#~ msgstr ""
#~ "יש לבחור באפשרות הזאת כדי לבחור את לוח השנה לאחסון הפריט עם כל יצירה של "
#~ "אירוע, מטלה או רשומת יומן חדשים. הבחירה הזאת מומלצת אם התכנון שלך הוא "
#~ "להשתמש במגוון חשבונות באמצעות Kontact כלקוח Kolab של KDE."

#~ msgid "Show Reminder Daemon in the System Tray"
#~ msgstr "הצגת סוכן תזכורות בשורת המערכת"

#~ msgid ""
#~ "Check this box to show the KOrganizer reminder daemon in the system tray."
#~ msgstr ""
#~ "יש לסמן את התיבה הזאת כדי לבציע את סוכן התזכורות של KOrganizer בשורת "
#~ "המערכת."

#~ msgid ""
#~ "Select your timezone from the list of locations in this drop down box. If "
#~ "your city is not listed, select one which shares the same timezone. "
#~ "KOrganizer will automatically adjust for daylight savings."
#~ msgstr ""
#~ "נא לבחור את אזור הזמן שלך מרשימת המקומות שבתיבה הנגללת. אם עירך לא מופיעה "
#~ "ברשימה, אפשר לבחור אחת שחולקת את אותו אזור זמן. KOrganizer יתאים אוטומטית "
#~ "את המעבר בין שעון חורף לשעון קיץ ולהפך."

#~ msgid "Day begins at"
#~ msgstr "היום מתחיל בשעה"

#~ msgid ""
#~ "Enter the start time for events here. This time should be the earliest "

#. i18n: ectx: label, entry (Destination), group (Save Settings)
#: eventviews.kcfg:15
#, kde-format
msgid "New Events, To-dos and Journal Entries Should"
msgstr "الأحداث والمهام ومدخلات اليوميّة الجديدة"

#. i18n: ectx: label, entry (Destination), group (Save Settings)
#: eventviews.kcfg:18
#, kde-format
msgid "Be added to the default calendar"
msgstr "ستُضاف إلى التقويم المبدئي"

#. i18n: ectx: tooltip, entry (Destination), group (Save Settings)
#: eventviews.kcfg:19
#, kde-format
msgid "Always save to the default calendar"
msgstr "احفظ دائمًا في التقويم المبدئي"

#. i18n: ectx: whatsthis, entry (Destination), group (Save Settings)
#: eventviews.kcfg:20
#, kde-format
msgid ""
"Select this option to always record new events, to-dos and journal entries "
"using the current default calendar."
msgstr ""
"حدد هذا الخيار لتسجيل الأحداث الجديدة والمهام وقيود اليومية دائمًا باستخدام "
"التقويم المبدئي الحالي."

#. i18n: ectx: label, entry (Destination), group (Save Settings)
#: eventviews.kcfg:23
#, kde-format
msgid "Be asked which calendar to use"
msgstr "ستسألك عن التقويم الذي سيُستخدم"

#. i18n: ectx: tooltip, entry (Destination), group (Save Settings)
#: eventviews.kcfg:24
#, kde-format
msgid "Always prompt for the calendar to use"
msgstr "اطلب دائمًا اختيار التقويم المستخدم"

#. i18n: ectx: whatsthis, entry (Destination), group (Save Settings)
#: eventviews.kcfg:25
#, kde-format
msgid ""
"Select this option to choose the calendar to be used to record the item each "
"time you create a new event, to-do or journal entry."
msgstr ""
"حدد هذا الخيار لاختيار التقويم المستخدم لتسجيل العنصر في كل مرة تنشئ فيها "
"حدثًا أو مهمة أو قيدًا في اليوميات."

#. i18n: ectx: label, entry (WeekStartDay), group (Time &amp; Date)
#: eventviews.kcfg:34
#, kde-format
msgid "Weekly start day:"
msgstr "يوم بدأ الأسبوع:"

#. i18n: ectx: tooltip, entry (WeekStartDay), group (Time &amp; Date)
#: eventviews.kcfg:35
#, kde-format
msgid "Select the first day of each week"
msgstr "اختر أوّل يوم من كل أسبوع"

#. i18n: ectx: whatsthis, entry (WeekStartDay), group (Time &amp; Date)
#: eventviews.kcfg:36
#, kde-format
msgid ""
"Select the first day of each week. Normally, you can ignore this since it is "
"set in your locale."
msgstr "اختر أوّل يوم من كل أسبوع. يمكنك عادةً تجاهل هذا فهو مضبوط في المحلية."

#. i18n: ectx: label, entry (WorkingHoursStart), group (Time &amp; Date)
#: eventviews.kcfg:40
#, kde-format
msgid "Daily starting hour"
msgstr "ساعة البداية اليومية"

#. i18n: ectx: tooltip, entry (WorkingHoursStart), group (Time &amp; Date)
#: eventviews.kcfg:41
#, kde-format
msgid "Set the time you typically start your day"
msgstr "حدد الوقت الذي تبدأ فيه يومك عادةً"

#. i18n: ectx: whatsthis, entry (WorkingHoursStart), group (Time &amp; Date)
#: eventviews.kcfg:42
#, kde-format
msgid ""
"Enter the start time for your daily schedule here. Your daily schedule hours "
"will be marked with a separate color."
msgstr "أدخِل وقت بدء جدولك اليومي هنا. ستُميز ساعات جدولك اليومي بلون منفصل."

#. i18n: ectx: label, entry (WorkingHoursEnd), group (Time &amp; Date)
#: eventviews.kcfg:46
#, kde-format
msgid "Daily ending hour"
msgstr "ساعة النهاية اليومية"

#. i18n: ectx: tooltip, entry (WorkingHoursEnd), group (Time &amp; Date)
#: eventviews.kcfg:47
#, kde-format
msgid "Set the time you typically end your day"
msgstr "حدد الوقت الذي ينتهي فيه يومك عادةً"

#. i18n: ectx: whatsthis, entry (WorkingHoursEnd), group (Time &amp; Date)
#: eventviews.kcfg:48
#, kde-format
msgid ""
"Enter the ending time for your daily schedule here. Your daily schedule "
"hours will be marked with a separate color."
msgstr "أدخِل وقت نهاية جدولك اليومي هنا. ستُميز ساعات جدولك اليومي بلون منفصل."

#. i18n: ectx: label, entry, group (General View)
#: eventviews.kcfg:55 viewerapp/settings.kcfg:9
#, kde-format
msgid "Enable tooltips for displaying summaries"
msgstr "مكّن التلميحات لعرض الملخّصات"

#. i18n: ectx: tooltip, entry, group (General View)
#: eventviews.kcfg:56
#, kde-format
msgid "Show event or to-do item tooltips"
msgstr "اعرض تلميحات الأحداث أو عناصر المهام"

#. i18n: ectx: whatsthis, entry, group (General View)
#: eventviews.kcfg:57 viewerapp/settings.kcfg:10
#, kde-format
msgid ""
"Check this box to display summary tooltips when hovering the mouse over an "
"event or a to-do."
msgstr ""
"أشّر على هذا المربع لعرض تلميحات أدوات التلخيص عند تحريك الفأرة فوق حدث أو "
"مهمة."

#. i18n: ectx: label, entry, group (General View)
#: eventviews.kcfg:61
#, kde-format
msgid "To-dos use tag colors"
msgstr "تستخدم المهام ألوان الوسوم"

#. i18n: ectx: tooltip, entry, group (General View)
#: eventviews.kcfg:62
#, kde-format
msgid "Draw to-do items using tag colors"
msgstr "ارسم عناصر المهام باستخدام ألوان الوسوم"

#. i18n: ectx: whatsthis, entry, group (General View)
#: eventviews.kcfg:63
#, kde-format
msgid ""
"Check this box so that to-dos will use tag colors and not colors specific to "
"their due, due today or overdue state"
msgstr ""
"حدد هذا المربع بحيث تستخدم المهام ألوان الوسم وليس الألوان الخاصة بالمستحق "
"أو المستحق اليوم أو حالة التأخير"

#. i18n: ectx: label, entry, group (General View)
#: eventviews.kcfg:67
#, kde-format
msgid "Next x days"
msgstr "الأيام كذا القادمة"

#. i18n: ectx: whatsthis, entry, group (General View)
#: eventviews.kcfg:68
#, kde-format
msgid ""
"Select the number of \"x\" days to be displayed in the next days view. To "
"access the next \"x\" days view, choose the \"Next X Days\" menu item from "
"the \"View\" menu."
msgstr ""
"اختر عدد الأيّام التي ستُعرض في منظور ”الأيام القادمة“. للوصول إلى منظور "
"”الأيام كذا القادمة“، اختر عنصر قائمة ”الأيام كذا القادمة“ من قائمة ”منظور“."

#. i18n: ectx: tooltip, entry, group (General View)
#: eventviews.kcfg:69
#, kde-format
msgid "Show this many days at a time in the Next \"x\" days view"
msgstr "اعرض هذا العدد من الأيام في آن واحد في منظور ”الأيام كذا القادمة“"

#. i18n: ectx: label, entry (DailyRecur), group (General View)
#: eventviews.kcfg:73
#, kde-format
msgid "Show items that recur daily"
msgstr "اعرض العناصر التي تتكرّر يوميًا"

#. i18n: ectx: tooltip, entry (DailyRecur), group (General View)
#: eventviews.kcfg:74
#, kde-format
msgid "Use a bold typeface to more easily identify daily recurring incidences"
msgstr "استخدم خطًا عريضًا لتسهيل تمييز الأحداث المتكررة يوميًا"

#. i18n: ectx: whatsthis, entry (DailyRecur), group (General View)
#: eventviews.kcfg:75
#, kde-format
msgid ""
"Check this box to show the days containing daily recurring incidences in "
"bold typeface in the Date Navigator, or uncheck it to give more prominence "
"to other (non daily recurring) incidences."
msgstr ""
"حدد هذا المربع لإظهار الأيام التي تحتوي على أحداث متكررة يوميًا بخط عريض في "
"متصفح التواريخ، أو ألغِ تحديده لإعطاء بروز أكبر للأحداث الأخرى (غير المتكررة "
"يوميًا)."

#. i18n: ectx: label, entry (WeeklyRecur), group (General View)
#: eventviews.kcfg:79
#, kde-format
msgid "Show items that recur weekly"
msgstr "اعرض العناصر التي تتكرّر أسبوعيًا"

#. i18n: ectx: tooltip, entry (WeeklyRecur), group (General View)
#: eventviews.kcfg:80
#, kde-format
msgid "Use a bold typeface to more easily identify weekly recurring incidences"
msgstr "استخدم خطًا عريضًا لتسهيل تمييز الأحداث المتكررة أسبوعيًا"

#. i18n: ectx: whatsthis, entry (WeeklyRecur), group (General View)
#: eventviews.kcfg:81
#, kde-format
msgid ""
"Check this box to show the days containing weekly recurring events in bold "
"typeface in the Date Navigator, or uncheck it to give more prominence to "
"other (non weekly recurring) events."
msgstr ""
"أشر على هذا المربع لإظهار الأيام التي تحتوي على أحداث أسبوعية متكررة بخط "
"غامق في متصفح التاريخ، أو ألغ تحديده لإعطاء أهمية أكبر للأحداث الأخرى (غير "
"المتكررة الأسبوعية)."

#. i18n: ectx: label, entry (HighlightTodos), group (General View)

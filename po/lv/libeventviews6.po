#~ msgstr "Izmantot sistēmas krāsu"

#~ msgid "Use system color. If enabled will ignore all other color settings"
#~ msgstr ""
#~ "Izmantot sistēmas krāsu. Ja ieslēgts, ignorēs visus pārējos krāsu "
